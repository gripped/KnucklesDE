prepare() {
  cd "$_pkgname"
  git config user.email "you@example.com"
  git config user.name "Your Name"
  
  git revert --no-edit 513aedf
  git revert --no-edit 1155348
  git revert --no-edit 6bc2da0
  if ! git revert --no-edit 6717767; then
    unmerged=$(git diff --name-only --diff-filter=U)
    if [[ "$unmerged" != "kcms/keyboard/keyboard_daemon.cpp" ]]; then
      echo "Unexpected conflict while reverting 6717767:"
      git status --short
      return 1
    fi
    git checkout --ours -- kcms/keyboard/keyboard_daemon.cpp
    git add -- kcms/keyboard/keyboard_daemon.cpp
    GIT_EDITOR=true git revert --continue
  fi
  git revert --no-edit e764b75
  git revert --no-edit 01958b3
  patch -Np1 < "$srcdir/0001-add-explicit-input-backend-options.patch"
  patch -Np1 < "$srcdir/keyboard.patch"
  patch -Np1 < "$srcdir/6bc2da0.patch"
  patch -Np1 < "$srcdir/1155348.patch"
  patch -Np1 < "$srcdir/model.patch"
  # patch -Np1 < "$srcdir/pager.diff"   # Personal
}

build() {
  cmake -B build  -S $_pkgname \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
