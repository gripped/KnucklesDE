From 6bc2da0840ef52610829c95baff0ee9cc0978e91 Mon Sep 17 00:00:00 2001
From: Joseph Crowell <joseph.w.crowell@gmail.com>
Date: Tue, 27 Oct 2026 10:22:39 +1000
Subject: [PATCH] kcms/keyboard: watch for kxkbrc created after kded starts

QFileSystemWatcher can't watch a file that doesn't exist, so a user
with no kxkbrc at login never had their first layout change applied
until kded restarted. Also watch the config directory and arm the
kxkbrc watch when the file appears.

Signed-off-by: Joseph Crowell <joseph.w.crowell@gmail.com>
---
 kcms/keyboard/keyboard_daemon.cpp            | 19 ++++++++++
 kcms/keyboard/keyboard_daemon.h              |  1 +
 kcms/keyboard/tests/keyboard_daemon_test.cpp | 39 +++++++++++++++++++-
 3 files changed, 58 insertions(+), 1 deletion(-)

diff --git a/kcms/keyboard/keyboard_daemon.cpp b/kcms/keyboard/keyboard_daemon.cpp
index d801ef0381..c705ca7edd 100644
--- a/kcms/keyboard/keyboard_daemon.cpp
+++ b/kcms/keyboard/keyboard_daemon.cpp
@@ -13,6 +13,7 @@
 #include <QDBusPendingCall>
 #include <QDir>
 #include <QFile>
+#include <QFileInfo>
 #include <QProcess>
 #include <QStandardPaths>
 
@@ -190,6 +191,7 @@ void KeyboardDaemon::registerListeners()
     if (!keyboardFileWatcher) {
         keyboardFileWatcher = new QFileSystemWatcher(this);
         connect(keyboardFileWatcher, &QFileSystemWatcher::fileChanged, this, &KeyboardDaemon::kxkbrcChanged);
+        connect(keyboardFileWatcher, &QFileSystemWatcher::directoryChanged, this, &KeyboardDaemon::kxkbrcDirectoryChanged);
     }
     if (!keyboardFileDebounce) {
         keyboardFileDebounce = new QTimer(this);
@@ -231,6 +233,7 @@ void KeyboardDaemon::unregisterListeners()
     }
     if (keyboardFileWatcher != nullptr) {
         disconnect(keyboardFileWatcher, &QFileSystemWatcher::fileChanged, this, &KeyboardDaemon::kxkbrcChanged);
+        disconnect(keyboardFileWatcher, &QFileSystemWatcher::directoryChanged, this, &KeyboardDaemon::kxkbrcDirectoryChanged);
     }
     if (keyboardFileDebounce != nullptr) {
         disconnect(keyboardFileDebounce, &QTimer::timeout, this, &KeyboardDaemon::kxkbrcDebounceTimeout);
@@ -269,6 +272,22 @@ void KeyboardDaemon::kxkbrcChanged(const QString &path)
     keyboardFileDebounce->start();
 }
 
+void KeyboardDaemon::kxkbrcDirectoryChanged(const QString &path)
+{
+    Q_UNUSED(path);
+    // Once kxkbrc is watched, its own events cover it; only a newly created file matters here.
+    const QString kxkbrc = kxkbrcPath();
+    if (kxkbrc.isEmpty() || keyboardFileWatcher->files().contains(kxkbrc) || !QFile::exists(kxkbrc)) {
+        return;
+    }
+    if (!keyboardFileWatcher->addPath(kxkbrc)) {
+        qCWarning(KCM_KEYBOARD) << "kxkbrc appeared but could not be watched at" << kxkbrc;
+    } else {
+        qCDebug(KCM_KEYBOARD) << "kxkbrc appeared at" << kxkbrc << "; now watching it";
+    }
+    keyboardFileDebounce->start();
+}
+
 void KeyboardDaemon::kxkbrcDebounceTimeout()
 {
     const QString kxkbrc = kxkbrcPath();
diff --git a/kcms/keyboard/keyboard_daemon.h b/kcms/keyboard/keyboard_daemon.h
index d590ddd033..2e44159bf5 100644
--- a/kcms/keyboard/keyboard_daemon.h
+++ b/kcms/keyboard/keyboard_daemon.h
@@ -54,6 +54,7 @@ private Q_SLOTS:
     void layoutChangedSlot();
     bool setLayout(QAction *action);
     void kxkbrcChanged(const QString &path);
+    void kxkbrcDirectoryChanged(const QString &path);
     void kxkbrcDebounceTimeout();
 
 public Q_SLOTS:
diff --git a/kcms/keyboard/tests/keyboard_daemon_test.cpp b/kcms/keyboard/tests/keyboard_daemon_test.cpp
index 71f970f727..c9f8891177 100644
--- a/kcms/keyboard/tests/keyboard_daemon_test.cpp
+++ b/kcms/keyboard/tests/keyboard_daemon_test.cpp
@@ -44,6 +44,10 @@ private Q_SLOTS:
         //    	const KAboutData* kAboutData = new KAboutData(i18n("a").toLatin1(), i18n("a").toLatin1(), KLocalizedString(), i18n("a").toLatin1());
         //    	KCmdLineArgs::init(kAboutData);
         keyboardDaemon = new KeyboardDaemon(this, QList<QVariant>());
+        // Startup configuration can make the X server report a layout map change,
+        // whose 1000 ms debounce emits layoutListChanged; let it fire before the
+        // tests start counting emissions.
+        QTest::qWait(2000);
     }
 
     void cleanupTestCase()
@@ -110,9 +114,42 @@ private Q_SLOTS:
         file.write(QByteArrayLiteral("[Layout]\nLayoutList=gb\nUse=false\n"));
         file.close();
 
-        QVERIFY(spy.wait(1000));
+        // Longer than the daemon's 1000 ms debounce.
+        QVERIFY(spy.wait(3000));
         QCOMPARE(spy.count(), 1);
     }
+
+    // A user who has never configured layouts has no kxkbrc when the daemon
+    // starts; the first save must still be picked up, and so must later ones.
+    void testKxkbrcCreatedLaterIsWatched()
+    {
+        QSignalSpy spy(keyboardDaemon, &KeyboardDaemon::layoutListChanged);
+        QVERIFY(spy.isValid());
+
+        const QString kxkbrc = QStandardPaths::writableLocation(QStandardPaths::GenericConfigLocation) + QStringLiteral("/kxkbrc");
+        QVERIFY(QFile::remove(kxkbrc));
+        // Let the debounce started by the removal run out before creating the file again.
+        QTest::qWait(2000);
+        spy.clear();
+
+        // Created by rename, the way KConfig saves through QSaveFile.
+        const QString staged = kxkbrc + QStringLiteral(".new");
+        QFile created(staged);
+        QVERIFY(created.open(QIODevice::WriteOnly | QIODevice::Text));
+        created.write(QByteArrayLiteral("[Layout]\nLayoutList=de\nUse=false\n"));
+        created.close();
+        QVERIFY(QFile::rename(staged, kxkbrc));
+        QVERIFY(spy.wait(3000));
+        spy.clear();
+
+        // Rewritten in place: no directory entry changes, so only a watch
+        // on the file itself sees this.
+        QFile rewritten(kxkbrc);
+        QVERIFY(rewritten.open(QIODevice::WriteOnly | QIODevice::Truncate | QIODevice::Text));
+        rewritten.write(QByteArrayLiteral("[Layout]\nLayoutList=fr\nUse=false\n"));
+        rewritten.close();
+        QVERIFY(spy.wait(3000));
+    }
 };
 
 // need GUI for xkb protocol in xkb_rules.cpp
