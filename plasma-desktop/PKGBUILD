prepare() {
  cd "$_pkgname"
  git config user.email "you@example.com"
  git config user.name "Your Name" 
  git revert --no-edit e764b75
  git revert --no-edit 01958b3
  patch -Np1 < "$srcdir/0001-add-explicit-input-backend-options.patch"
  patch -Np1 < "$srcdir/keyboard.patch"
  patch -Np1 < "$srcdir/model.patch"
  patch -Np1 < "$srcdir/synaptics.patch"
  patch -Np1 < "$srcdir/pager.diff"   # Personal
  
}

build() {
  cmake -B build  -S $_pkgname \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
